#(no_builtins)

extern C {
    fn printf(str: RawString,...) -> i32
}

a = 1
b = "Hello world\n"

printf("%d\n",a)

c = true

if c == true {
    printf("True!\n")
} else {
    printf("False!\n")
}

while a != 20 {
    a += 1
    printf("A is %d\n",a)
    a
}

fn my_function(a: i32) -> i32 {
    printf("double it and give it to the next one: %d\n",a)
    return a * 2
}

printf("%d\n",my_function(67890))